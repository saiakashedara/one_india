# === DATABASE ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oneindia_dev
DB_USER=postgres
DB_PASSWORD=password

# === JWT ===
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# === REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === API ===
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# === SECURITY ===
JSON_BODY_LIMIT=50kb
FORM_BODY_LIMIT=50kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
BLOCKED_IPS=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# === PRODUCTION INTEGRATIONS ===
# Add real provider credentials before enabling live payments, SMS, email, files, and maps.
PAYMENT_GATEWAY_MODE=sandbox
MAPS_PROVIDER=google
MAPS_API_KEY=
FILE_UPLOAD_MAX_BYTES=5242880
PUBLIC_HTTPS_URL=https://your-domain.example

# === PAYMENTS ===
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLIC_KEY=pk_test_your_key
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# === EXTERNAL SERVICES ===
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_key

# === LOGGING ===
LOG_LEVEL=debug
